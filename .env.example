# Application
DEBUG=true
NAME=fastapi-template
DESCRIPTION=FastAPI Template Project
VERSION=0.0.2

# URLs
TEST_URL=http://localhost:8000
PROD_URL=http://localhost:8000

# Security
SECRET_KEY=SECRET_KEY_PLACEHOLDER
HASHING_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (Development)
POSTGRES_DEV_USER=postgres
POSTGRES_DEV_PASSWORD=POSTGRES_DEV_PASSWORD_PLACEHOLDER
POSTGRES_DEV_SERVER=localhost

# Database (Production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=POSTGRES_PASSWORD_PLACEHOLDER
POSTGRES_SERVER=localhost

POSTGRES_PORT=5432
POSTGRES_DB=fastapi-template

# Google OAuth
SERVICE_CALLER_GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID_PLACEHOLDER.apps.googleusercontent.com
SERVICE_CALLER_GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET_PLACEHOLDER

# Redirect URIs for Google OAuth
SERVICE_CALLER_GOOGLE_REDIRECT_LOGIN_URI=http://localhost:8000/callback/register
SERVICE_CALLER_GOOGLE_REDIRECT_REGISTER_URI=http://localhost:8000/callback/register

# AWS
AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID_PLACEHOLDER
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY_PLACEHOLDER
AWS_REGION=eu-central-1
AWS_SES_SENDER=SENDER_EMAIL_PLACEHOLDER
